{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{"source":"/owner","destination":"/api/owner"}],
  "headers": [
    {"source":"/products.json","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/server/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex"}]}
  ]
}
